{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Cross-Origin-Embedder-Policy",
          "value": "require-corp"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/assets/classic/game/:match*",
      "destination": "https://gta.rabisco.net/assets/classic/game/:match*"
    },
    {
      "source": "/assets/classic/localization/:match*",
      "destination": "https://gta.rabisco.net/assets/classic/localization/:match*"
    }
  ]
}
